# Docker ignore para optimizar el build del backend

# Archivos de target (se generan en el build)
target/
!target/*.jar

# Archivos de IDE
.vscode/
.idea/
*.iml
*.iws
*.ipr

# Archivos de sistema
.DS_Store
Thumbs.db

# Archivos de git
.git/
.gitignore

# Archivos de logs
*.log

# Archivos temporales
*.tmp
*.temp

# Archivos de desarrollo
run.sh
README.md

# Dockerfile de desarrollo
Dockerfile
