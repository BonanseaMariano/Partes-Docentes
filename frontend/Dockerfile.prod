# Dockerfile para producción en Render
# Aplicación Angular - Frontend

# Etapa 1: Construcción
FROM node:18-alpine AS build

# Establecer directorio de trabajo
WORKDIR /app

# Copiar archivos de dependencias
COPY cli/package*.json ./

# Instalar todas las dependencias (incluyendo devDependencies para el build)
RUN npm install

# Copiar el código fuente
COPY cli/ ./

# Construir la aplicación para producción
RUN npm run build

# Verificar que el build fue exitoso
RUN ls -la dist/

# Etapa 2: Servir con nginx
FROM nginx:alpine

# Remover la configuración por defecto de nginx
RUN rm /etc/nginx/conf.d/default.conf

# Limpiar completamente el directorio html
RUN rm -rf /usr/share/nginx/html/*

# Copiar la configuración personalizada de nginx
COPY nginx.conf /etc/nginx/nginx.conf

# Copiar los archivos construidos
COPY --from=build /app/dist/cli /usr/share/nginx/html

# Verificar que los archivos se copiaron
RUN ls -la /usr/share/nginx/html/

# Exponer puerto 80
EXPOSE 80

# Comando por defecto
CMD ["nginx", "-g", "daemon off;"]
